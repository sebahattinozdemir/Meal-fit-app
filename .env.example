# RevenueCat public SDK keys (Dashboard → Project → API keys → App specific)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxxxxxxx

# Expo / EAS (expo.dev → Account Settings → Access Tokens)
EXPO_TOKEN=
EXPO_ACCOUNT=your-expo-username
EAS_PROJECT_ID=

# Hosted legal pages (GitHub Pages: repo Settings → Pages → main /docs)
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://sebahattinozdemir.github.io/Meal-fit-app/privacy.html
EXPO_PUBLIC_TERMS_URL=https://sebahattinozdemir.github.io/Meal-fit-app/terms.html
EXPO_PUBLIC_SUPPORT_EMAIL=support@mealfit.app

# Set to "mock" to force simulated purchases in EAS builds (development profile uses this)
# EXPO_PUBLIC_IAP_MODE=mock
